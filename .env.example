# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-gerado

# Opcional. Sem esta linha, usa o SQLite local (instance/rastreio.db)
# DATABASE_URL=sqlite:///rastreio.db

# Provedor de rastreio: "simulado" (padrão) ou "correios" (depois da etapa 7)
PROVEDOR_RASTREIO=simulado

# Endereço público do sistema (links dos clientes e prévia do WhatsApp)
URL_BASE_PUBLICA=http://127.0.0.1:5000

# Nome exibido nas páginas
NOME_EMPRESA=Lance Replay

# --- Correios (API Rastro) ---
# "producao" (cws.correios.com.br) ou "homologacao" (cwshom.correios.com.br)
CORREIOS_AMBIENTE=producao
# Chave de acesso criada no CWS (menu Chaves de acesso). Deixe em BRANCO aqui!
CORREIOS_CHAVE_ACESSO=
# Tempo limite das chamadas, em segundos (opcional)
# CORREIOS_TIMEOUT=15